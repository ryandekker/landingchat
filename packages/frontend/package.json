{
  "name": "@landingchat/frontend",
  "version": "1.0.0",
  "description": "React frontend for LandingChat",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "deploy": "pnpm build && wrangler pages deploy dist"
  },
  "keywords": ["react", "frontend", "cloudflare-pages"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@landingchat/shared": "workspace:*",
    "@tanstack/react-query": "^5.17.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "wrangler": "^3.22.1"
  }
}
